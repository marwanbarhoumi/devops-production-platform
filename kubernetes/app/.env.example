# -----------------------------------------------------------------------------
# devops-production-platform - Kubernetes application secrets (namespace devops-platform)
#
#   Copy-Item kubernetes/app/.env.example kubernetes/app/.env   (PowerShell)
#   cp kubernetes/app/.env.example kubernetes/app/.env          (Linux/macOS/Git Bash)
#
# kubernetes/app/.env is git-ignored and becomes the Secret "postgres-credentials" (kubectl apply -k).
# Use new random values; do not reuse the Docker Compose .env. LOCAL DEVELOPMENT ONLY.
# -----------------------------------------------------------------------------

# PostgreSQL superuser "postgres" (StatefulSet and first-boot script only).
POSTGRES_PASSWORD=change-me-postgres-superuser

# Least-privilege roles of the services (product_svc owns products_db, order_svc owns orders_db).
PRODUCT_DB_PASSWORD=change-me-product-service
ORDER_DB_PASSWORD=change-me-order-service
