# -----------------------------------------------------------------------------
# devops-production-platform - Kubernetes monitoring secrets (namespace monitoring)
#
#   Copy-Item kubernetes/monitoring/.env.example kubernetes/monitoring/.env   (PowerShell)
#   cp kubernetes/monitoring/.env.example kubernetes/monitoring/.env          (Linux/macOS/Git Bash)
#
# kubernetes/monitoring/.env is git-ignored and becomes the Secret "grafana-admin" (kubectl apply -k).
# Do not copy monitoring/.env (Docker Compose). LOCAL DEVELOPMENT ONLY.
# -----------------------------------------------------------------------------

# Applied only when Grafana's database is first created (PersistentVolumeClaim grafana-data).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
