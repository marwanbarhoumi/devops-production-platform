# -----------------------------------------------------------------------------
# devops-production-platform - example configuration
#
# Copy to `.env` and replace every `change-me-*` value before starting:
#   cp .env.example .env            (Linux/macOS/Git Bash)
#   Copy-Item .env.example .env     (PowerShell)
#
# These values are for LOCAL DEVELOPMENT ONLY. `.env` is git-ignored.
# -----------------------------------------------------------------------------

# Tag applied to locally built images (devops-production-platform/<service>:<tag>)
IMAGE_TAG=local

# Log level for all services: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- PostgreSQL ---------------------------------------------------------------
# Superuser used only by the postgres container and its init scripts.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-superuser
# Host port for PostgreSQL (bound to 127.0.0.1 only). 15432 avoids clashing with a locally installed PostgreSQL.
POSTGRES_HOST_PORT=15432

# Least-privilege application roles. Each service owns its own database.
PRODUCT_DB_PASSWORD=change-me-product-db
ORDER_DB_PASSWORD=change-me-order-db

# --- Published ports (host side) ---------------------------------------------
# Use 0.0.0.0 to expose the gateway to other machines on your network.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_HOST_PORT=7000
# Internal services are published on 127.0.0.1 only, for local debugging.
PRODUCT_SERVICE_HOST_PORT=7001
ORDER_SERVICE_HOST_PORT=7002

# --- Timeouts (milliseconds) -------------------------------------------------
# Gateway -> downstream services. Must be greater than PRODUCT_SERVICE_TIMEOUT_MS.
UPSTREAM_TIMEOUT_MS=5000
# order-service -> product-service.
PRODUCT_SERVICE_TIMEOUT_MS=2000
