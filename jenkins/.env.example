# Optional overrides for the Jenkins stack (jenkins/docker-compose.yml).
# Copy to jenkins/.env only if you need to change something. jenkins/.env is git-ignored.
# No secrets belong here: the agent secret lives in jenkins/secrets/agent-secret (also git-ignored).

# Host port and bind address of the Jenkins web UI. Keep 127.0.0.1 unless you know why you need more.
JENKINS_HTTP_PORT=8090
JENKINS_BIND_ADDRESS=127.0.0.1

# Public URL of Jenkins, used in links and shown to GitHub. Must match the port above,
# or your public HTTPS URL if you expose Jenkins for webhooks (see README "GitHub integration").
JENKINS_URL=http://localhost:8090/
