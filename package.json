{
  "name": "devops-production-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Production-oriented microservices platform used to demonstrate DevOps, CI/CD, Kubernetes and observability practices.",
  "type": "module",
  "workspaces": [
    "services/api-gateway",
    "services/product-service",
    "services/order-service"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:ci": "node scripts/ci/run-unit-tests.mjs",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:integration:ci": "node scripts/run-integration-tests.mjs --ephemeral-db",
    "ci:toolchain": "node scripts/ci/verify-toolchain.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "build": "npm run build --workspaces",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build",
    "compose:validate": "docker compose config --quiet",
    "compose:up": "docker compose up -d --build --wait",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f --tail=100"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  }
}
