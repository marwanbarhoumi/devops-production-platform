# -----------------------------------------------------------------------------
# devops-production-platform - observability stack configuration
#
#   Copy-Item monitoring/.env.example monitoring/.env   (PowerShell)
#   cp monitoring/.env.example monitoring/.env          (Linux/macOS/Git Bash)
#
# `monitoring/.env` is git-ignored. Replace every `change-me-*` value. LOCAL DEVELOPMENT ONLY.
# -----------------------------------------------------------------------------

# --- Grafana ------------------------------------------------------------------
# Applied only when Grafana's database is first created (volume dpp-monitoring-grafana-data).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin

# --- Alertmanager notifications ----------------------------------------------
# File (relative to monitoring/) containing only the URL of the webhook that receives firing and resolved
# alerts (JSON, Alertmanager webhook format), e.g. a chat integration or an incident tool. Many webhook URLs
# embed a token, so keep the file under monitoring/secrets/ (git-ignored):
#   New-Item -ItemType Directory -Force monitoring/secrets
#   Set-Content monitoring/secrets/alertmanager-webhook-url 'https://...'
# Create the file before starting the stack; then recreate Alertmanager to pick up a change:
#   docker compose -f monitoring/docker-compose.yml up -d --wait --force-recreate alertmanager
# Unset: an empty file is used; alerts stay visible in Alertmanager and Prometheus but are not sent anywhere.
# ALERTMANAGER_WEBHOOK_URL_FILE=./secrets/alertmanager-webhook-url

# --- Published ports (always bound to 127.0.0.1) ------------------------------
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
GRAFANA_HOST_PORT=3000

# --- Prometheus storage --------------------------------------------------------
# Whichever limit is reached first removes the oldest data.
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB
